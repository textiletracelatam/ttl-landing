---
import { appConfig } from "../config";
---

<div
  class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm sm:p-10 dark:border-neutral-700 dark:bg-neutral-800/50"
>
  <div id="contact-form-wrapper">
    <h2 class="text-2xl font-semibold text-neutral-900 dark:text-white">
      Envíanos un mensaje
    </h2>
    <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
      Completa el formulario y nos pondremos en contacto contigo.
    </p>
    <form
      id="contact-form"
      data-action={`${appConfig.ttlApiHost}/api/v1/contacts`}
      class="mt-8 space-y-6"
    >
      <div class="grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-2">
        <div>
          <label
            for="givenName"
            class="block text-sm/6 font-semibold text-neutral-900 dark:text-white"
            >Nombre</label
          >
          <input
            type="text"
            id="givenName"
            name="givenName"
            autocomplete="givenName"
            required
            class="mt-2 block w-full rounded-md bg-white px-3.5 py-2 text-base text-neutral-900 outline-1 -outline-offset-1 outline-neutral-300 placeholder:text-neutral-400 focus:outline-2 focus:-outline-offset-2 focus:outline-primary-600 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-neutral-500 dark:focus:outline-primary-500"
          />
        </div>
        <div>
          <label
            for="familyName"
            class="block text-sm/6 font-semibold text-neutral-900 dark:text-white"
            >Apellido</label
          >
          <input
            type="text"
            id="familyName"
            name="familyName"
            autocomplete="familyName"
            class="mt-2 block w-full rounded-md bg-white px-3.5 py-2 text-base text-neutral-900 outline-1 -outline-offset-1 outline-neutral-300 placeholder:text-neutral-400 focus:outline-2 focus:-outline-offset-2 focus:outline-primary-600 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-neutral-500 dark:focus:outline-primary-500"
          />
        </div>
      </div>

      <div>
        <label
          for="email"
          class="block text-sm/6 font-semibold text-neutral-900 dark:text-white"
          >Correo electrónico</label
        >
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
          class="mt-2 block w-full rounded-md bg-white px-3.5 py-2 text-base text-neutral-900 outline-1 -outline-offset-1 outline-neutral-300 placeholder:text-neutral-400 focus:outline-2 focus:-outline-offset-2 focus:outline-primary-600 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-neutral-500 dark:focus:outline-primary-500"
        />
      </div>

      <div>
        <label
          for="company"
          class="block text-sm/6 font-semibold text-neutral-900 dark:text-white"
          >Empresa</label
        >
        <input
          type="text"
          id="company"
          name="company"
          autocomplete="company"
          class="mt-2 block w-full rounded-md bg-white px-3.5 py-2 text-base text-neutral-900 outline-1 -outline-offset-1 outline-neutral-300 placeholder:text-neutral-400 focus:outline-2 focus:-outline-offset-2 focus:outline-primary-600 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-neutral-500 dark:focus:outline-primary-500"
        />
      </div>

      <div>
        <label
          for="message"
          class="block text-sm/6 font-semibold text-neutral-900 dark:text-white"
          >Mensaje</label
        >
        <textarea
          id="message"
          name="message"
          rows={4}
          required
          class="mt-2 block w-full rounded-md bg-white px-3.5 py-2 text-base text-neutral-900 outline-1 -outline-offset-1 outline-neutral-300 placeholder:text-neutral-400 focus:outline-2 focus:-outline-offset-2 focus:outline-primary-600 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-neutral-500 dark:focus:outline-primary-500"
        ></textarea>
      </div>

      <div>
        <button
          type="submit"
          class="w-full rounded-md bg-primary-600 px-5 py-3 text-sm font-semibold text-white shadow-xs hover:bg-primary-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:bg-primary-500 dark:hover:bg-primary-400 dark:focus-visible:outline-primary-500"
        >
          Enviar mensaje
        </button>
      </div>

      <p
        id="contact-form-error"
        class="hidden text-sm text-red-600 dark:text-red-400"
        role="alert"
      >
      </p>
    </form>
  </div>

  <div
    id="contact-success"
    class="hidden flex-col items-center py-6 text-center"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      class="h-12 w-12 text-primary-600 dark:text-primary-500"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
      ></path>
    </svg>
    <h2 class="mt-4 text-2xl font-semibold text-neutral-900 dark:text-white">
      ¡Mensaje enviado!
    </h2>
    <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
      Gracias por contactarnos. Nos pondremos en contacto contigo pronto.
    </p>
    <button
      id="contact-reset"
      type="button"
      class="mt-6 rounded-md bg-primary-600 px-5 py-3 text-sm font-semibold text-white shadow-xs hover:bg-primary-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:bg-primary-500 dark:hover:bg-primary-400 dark:focus-visible:outline-primary-500"
    >
      Enviar otro mensaje
    </button>
  </div>
</div>

<script>
  const formWrapper = document.getElementById("contact-form-wrapper")!;
  const successWrapper = document.getElementById("contact-success")!;
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const errorMsg = document.getElementById("contact-form-error")!;
  const resetBtn = document.getElementById("contact-reset")!;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorMsg.classList.add("hidden");

    const submitBtn = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    )!;
    submitBtn.disabled = true;

    try {
      const res = await fetch(form.dataset.action!, {
        method: "POST",
        body: new FormData(form), // sent as multipart/form-data, no Content-Type header set manually
      });

      if (!res.ok) throw new Error("Request failed");

      formWrapper.classList.add("hidden");
      successWrapper.classList.remove("hidden");
      successWrapper.classList.add("flex");
    } catch (err) {
      errorMsg.textContent = "Algo salió mal. Por favor, inténtalo de nuevo.";
      errorMsg.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
    }
  });

  resetBtn.addEventListener("click", () => {
    form.reset();
    successWrapper.classList.add("hidden");
    successWrapper.classList.remove("flex");
    formWrapper.classList.remove("hidden");
  });
</script>
