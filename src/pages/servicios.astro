---
import Layout from "../layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";
const { phoneMockupLight, phoneMockupDark, phoneMockupAlt, ctaPrimaryColor } =
  (await getEntry("homeHero", "hero"))!.data;

interface Props {}

const { tagline, heading, description, image, imageDark, imageAlt, stats } =
  (await getEntry("homeMission", "mission"))!.data;

const servicios = (await getCollection("servicios")).sort(
  (a, b) => a.data.order - b.data.order,
);

type CardColor = "white" | "primary" | "black";

const cardStyles: Record<CardColor, string> = {
  white: "ring-1 ring-neutral-200 dark:bg-neutral-800/50 dark:ring-white/10",
  primary:
    "bg-primary-600 ring-1 ring-primary-600 dark:bg-primary-700 dark:ring-primary-500",
  black:
    "bg-neutral-900 ring-1 ring-neutral-900 dark:bg-neutral-800/50 dark:ring-2 dark:ring-primary-500",
};

const titleStyles: Record<CardColor, string> = {
  white: "text-neutral-900 dark:text-white",
  primary: "text-white",
  black: "text-white dark:text-primary-400",
};

const descStyles: Record<CardColor, string> = {
  white: "text-neutral-600 dark:text-neutral-300",
  primary: "text-primary-100",
  black: "text-neutral-300",
};

const priceStyles: Record<CardColor, string> = {
  white: "text-neutral-900 dark:text-white",
  primary: "text-white",
  black: "text-white",
};

const priceSuffixStyles: Record<CardColor, string> = {
  white: "text-neutral-600 dark:text-neutral-400",
  primary: "text-primary-200",
  black: "text-neutral-300",
};

const ctaStyles: Record<CardColor, string> = {
  white:
    "bg-primary-600 text-white shadow-xs hover:bg-primary-500 focus-visible:outline-primary-600 dark:bg-primary-500 dark:hover:bg-primary-400 dark:focus-visible:outline-primary-500",
  primary:
    "bg-white text-primary-700 shadow-xs hover:bg-primary-50 focus-visible:outline-white",
  black:
    "bg-white/10 text-white inset-ring inset-ring-white/5 hover:bg-white/20 focus-visible:outline-white/75",
};

const featureTextStyles: Record<CardColor, string> = {
  white: "text-neutral-600 dark:text-neutral-300",
  primary: "text-primary-100",
  black: "text-neutral-300",
};

const checkStyles: Record<CardColor, string> = {
  white: "text-primary-600 dark:text-primary-400",
  primary: "text-white",
  black: "text-white",
};

const linkStyles: Record<CardColor, string> = {
  white:
    "text-primary-600 hover:text-primary-500 dark:text-primary-400 dark:hover:text-primary-300",
  primary: "text-white/90 hover:text-white",
  black: "text-white/80 hover:text-white",
};

const filledStyles = {
  primary: "bg-primary-500 hover:bg-primary-400",
  secondary: "bg-secondary-500 hover:bg-secondary-400",
  neutral:
    "bg-neutral-800 hover:bg-neutral-700 dark:bg-neutral-200 dark:hover:bg-neutral-300 dark:text-neutral-900",
} as const;
---

<Layout title="Servicios">
  <div class="isolate">
    <!-- Header -->
    <div class="px-6 pt-0 pb-1 lg:px-8">
      <div class="mx-auto max-w-2xl pt-12 text-center sm:pt-8">
        <h1
          class="text-5xl font-semibold tracking-tight text-neutral-900 sm:text-7xl dark:text-white"
        >
          Servicios
        </h1>
        <p
          class="mt-5 text-lg font-medium text-pretty text-neutral-500 sm:text-xl/8 dark:text-neutral-400"
        >
          Soluciones de trazabilidad textil diseñadas para impulsar la
          transparencia y sostenibilidad de tu cadena de valor.
        </p>
      </div>
    </div>

<!-- sección con el telefono -->
    <div class="bg-white">
      <div class="relative isolate overflow-hidden bg-background">
        <div
          aria-hidden="true"
          class="absolute top-10 left-[calc(50%-4rem)] -z-10 transform-gpu blur-3xl sm:left-[calc(50%-18rem)] lg:top-[calc(50%-30rem)] lg:left-48 xl:left-[calc(50%-24rem)]"
        >
          <div
            style="clip-path: polygon(73.6% 51.7%, 91.7% 11.8%, 100% 46.4%, 97.4% 82.2%, 92.5% 84.9%, 75.7% 64%, 55.3% 47.5%, 46.5% 49.4%, 45% 62.9%, 50.3% 87.2%, 21.3% 64.1%, 0.1% 100%, 5.4% 51.1%, 21.4% 63.9%, 58.9% 0.2%, 73.6% 51.7%)"
            class="aspect-1108/632 w-277 bg-linear-to-r from-primary-300 to-secondary-300 opacity-20"
          >
          </div>
        </div>
        <div
          class="mx-auto max-w-7xl px-6 py-12 sm:py-16 lg:flex lg:items-center lg:gap-x-10 lg:px-8 lg:py-10"
        >
          <div class="mx-auto max-w-2xl lg:mx-0 lg:flex-auto">
            <h1
              class="mt-1 text-4xl font-semibold tracking-tight text-pretty text-neutral-900 sm:text-5xl dark:text-white"
            >
              Soluciones de trazabilidad para empresas textiles que quieren
              prepararse para el futuro.
            </h1>
            <p
              class="mt-8 text-lg font-medium text-pretty text-neutral-500 sm:text-xl/8 dark:text-neutral-400"
            >
              No importa si estás dando tus primeros pasos en trazabilidad o si
              gestionas miles de productos. Diseñamos soluciones que se adaptan
              al tamaño de tu empresa para ayudarte a construir información
              confiable, fortalecer tu marca y responder a las nuevas exigencias
              del mercado.
            </p>
            <div class="mt-10 flex items-center gap-x-6">
              <a
                href="#pricing"
                class:list={[
                  "rounded-md px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs transition-colors",
                  filledStyles[ctaPrimaryColor],
                ]}>Ver planes</a
              >
            </div>
          </div>
          <div class="mt-16 sm:mt-24 lg:mt-0 lg:shrink-0 lg:grow">
            <svg
              role="img"
              viewBox="0 0 366 729"
              class="mx-auto w-80 max-w-full drop-shadow-xl"
            >
              <title>titulito</title>
              <defs>
                <clipPath id="phone-clip">
                  <rect width="316" height="684" rx="36"></rect>
                </clipPath>
              </defs>
              <path
                d="M363.315 64.213C363.315 22.99 341.312 1 300.092 1H66.751C25.53 1 3.528 22.99 3.528 64.213v44.68l-.857.143A2 2 0 0 0 1 111.009v24.611a2 2 0 0 0 1.671 1.973l.95.158a2.26 2.26 0 0 1-.093.236v26.173c.212.1.398.296.541.643l-1.398.233A2 2 0 0 0 1 167.009v47.611a2 2 0 0 0 1.671 1.973l1.368.228c-.139.319-.314.533-.511.653v16.637c.221.104.414.313.56.689l-1.417.236A2 2 0 0 0 1 237.009v47.611a2 2 0 0 0 1.671 1.973l1.347.225c-.135.294-.302.493-.49.607v377.681c0 41.213 22 63.208 63.223 63.208h95.074c.947-.504 2.717-.843 4.745-.843l.141.001h.194l.086-.001 33.704.005c1.849.043 3.442.37 4.323.838h95.074c41.222 0 63.223-21.999 63.223-63.212v-394.63c-.259-.275-.48-.796-.63-1.47l-.011-.133 1.655-.276A2 2 0 0 0 366 266.62v-77.611a2 2 0 0 0-1.671-1.973l-1.712-.285c.148-.839.396-1.491.698-1.811V64.213Z"
                fill="#4B5563"></path>
              <path
                d="M16 59c0-23.748 19.252-43 43-43h246c23.748 0 43 19.252 43 43v615c0 23.196-18.804 42-42 42H58c-23.196 0-42-18.804-42-42V59Z"
                fill="#343E4E"></path>
              <foreignObject
                width="316"
                height="684"
                clip-path="url(#phone-clip)"
                transform="translate(24 24)"
              >
                <img
                  src={phoneMockupLight}
                  alt={phoneMockupAlt}
                  class="dark:hidden"
                />
                <img
                  src={phoneMockupDark}
                  alt={phoneMockupAlt}
                  class="hidden dark:block"
                />
              </foreignObject>
            </svg>
          </div>
        </div>
      </div>
    </div>

<!-- sección img izq -->
    <div class="relative bg-white dark:bg-neutral-900">
      <img
        src={image}
        alt={imageAlt}
        class:list={[
          "h-56 w-full bg-neutral-50 object-cover lg:absolute lg:inset-y-0 lg:left-0 lg:h-full lg:w-1/2 dark:bg-neutral-800",
          imageDark && "dark:hidden",
        ]}
      />
      {
        imageDark && (
          <img
            src={imageDark}
            alt={imageAlt}
            class="hidden h-56 w-full bg-neutral-800 object-cover lg:absolute lg:inset-y-0 lg:left-0 lg:h-full lg:w-1/2 dark:block"
          />
        )
      }
      <div class="mx-auto grid max-w-7xl lg:grid-cols-2">
        <div
          class="px-6 pt-16 pb-24 sm:pt-20 sm:pb-32 lg:col-start-2 lg:px-8 lg:pt-32"
        >
          <div class="mx-auto max-w-2xl lg:mr-0 lg:max-w-lg">
            <h2
              class="text-base/8 font-semibold text-primary-600 dark:text-primary-400"
            >
              como
            </h2>
            <p
              class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-neutral-900 sm:text-5xl dark:text-white"
            >
              Más que un Pasaporte Digital de Producto
            </p>
            <div
              class="mt-6 space-y-4 text-lg/8 text-neutral-600 dark:text-neutral-300"
            >
              {
                description
                  .split("\n\n")
                  .map((paragraph) => (
                    <p>
                      Implementar la trazabilidad no consiste únicamente en
                      generar un código QR.Implica organizar información,
                      comprender la cadena de suministro y preparar a tu empresa
                      para responder con confianza a clientes, aliados
                      comerciales y mercados internacionales.En Textile Trace
                      LATAM te acompañamos durante ese proceso para que puedas
                      avanzar paso a paso, según las necesidades de tu negocio.
                    </p>
                  ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Pricing section -->
    <form id="pricing" class="group/tiers bg-white py-5 dark:bg-neutral-900">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mt-16 flex justify-center">
          <fieldset aria-label="Frecuencia de pago">
            <div
              class="grid grid-cols-2 gap-x-1 rounded-full p-1 text-center text-xs/5 font-semibold inset-ring inset-ring-neutral-200 dark:inset-ring-white/10"
            >
              <label
                class="group relative rounded-full px-2.5 py-1 has-checked:bg-primary-600 dark:has-checked:bg-primary-500"
              >
                <input
                  type="radio"
                  name="frequency"
                  value="monthly"
                  checked
                  class="absolute inset-0 appearance-none rounded-full"
                />
                <span
                  class="text-neutral-500 group-has-checked:text-white dark:text-neutral-400"
                  >Mensual</span
                >
              </label>
              <label
                class="group relative rounded-full px-2.5 py-1 has-checked:bg-primary-600 dark:has-checked:bg-primary-500"
              >
                <input
                  type="radio"
                  name="frequency"
                  value="annually"
                  class="absolute inset-0 appearance-none rounded-full"
                />
                <span
                  class="text-neutral-500 group-has-checked:text-white dark:text-neutral-400"
                  >Anual</span
                >
              </label>
            </div>
          </fieldset>
        </div>
        <div
          class="isolate mx-auto mt-10 grid max-w-md grid-cols-1 gap-8 lg:mx-0 lg:max-w-none lg:grid-cols-3"
        >
          {
            servicios.map((servicio) => {
              const color = servicio.data.cardColor;
              return (
                <div
                  class:list={[
                    "flex flex-col rounded-3xl p-8 xl:p-10",
                    cardStyles[color],
                  ]}
                >
                  <h3
                    id={`tier-${servicio.id}`}
                    class:list={["text-lg/8 font-semibold", titleStyles[color]]}
                  >
                    {servicio.data.name}
                  </h3>
                  <p class:list={["mt-4 text-sm/6", descStyles[color]]}>
                    {servicio.data.description}
                  </p>
                  <p
                    class:list={[
                      "mt-6 flex items-baseline gap-x-1 group-not-has-[[name=frequency][value=monthly]:checked]/tiers:hidden",
                    ]}
                  >
                    <span
                      class:list={[
                        "text-4xl font-semibold tracking-tight",
                        priceStyles[color],
                      ]}
                    >
                      {servicio.data.monthlyPrice}
                    </span>
                    <span
                      class:list={[
                        "text-sm/6 font-semibold",
                        priceSuffixStyles[color],
                      ]}
                    >
                      /mes
                    </span>
                  </p>
                  <p
                    class:list={[
                      "mt-6 flex items-baseline gap-x-1 group-not-has-[[name=frequency][value=annually]:checked]/tiers:hidden",
                    ]}
                  >
                    <span
                      class:list={[
                        "text-4xl font-semibold tracking-tight",
                        priceStyles[color],
                      ]}
                    >
                      {servicio.data.annualPrice}
                    </span>
                    <span
                      class:list={[
                        "text-sm/6 font-semibold",
                        priceSuffixStyles[color],
                      ]}
                    >
                      /año
                    </span>
                  </p>
                  <a
                    href={`/servicios/${servicio.id}`}
                    aria-describedby={`tier-${servicio.id}`}
                    class:list={[
                      "mt-6 block w-full rounded-md px-3 py-2 text-center text-sm/6 font-semibold focus-visible:outline-2 focus-visible:outline-offset-2",
                      ctaStyles[color],
                    ]}
                  >
                    {servicio.data.cta}
                  </a>
                  <ul
                    role="list"
                    class:list={[
                      "mt-8 flex-1 space-y-3 text-sm/6 xl:mt-10",
                      featureTextStyles[color],
                    ]}
                  >
                    {servicio.data.features.map((feature) => (
                      <li class="flex gap-x-3">
                        <svg
                          viewBox="0 0 20 20"
                          fill="currentColor"
                          aria-hidden="true"
                          class:list={["h-6 w-5 flex-none", checkStyles[color]]}
                        >
                          <path
                            d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                            clip-rule="evenodd"
                            fill-rule="evenodd"
                          />
                        </svg>
                        {feature}
                      </li>
                    ))}
                  </ul>
                  {servicio.data.linkText && servicio.data.linkHref && (
                    <a
                      href={servicio.data.linkHref}
                      class:list={[
                        "mt-8 block text-center text-sm/6 font-semibold",
                        linkStyles[color],
                      ]}
                    >
                      {servicio.data.linkText}{" "}
                      <span aria-hidden="true">&rarr;</span>
                    </a>
                  )}
                </div>
              );
            })
          }
        </div>
      </div>
    </form>
  </div>

<!-- sección img der -->
  <div class="relative bg-white dark:bg-neutral-900">
    <img
      src={image}
      alt={imageAlt}
      class:list={[
        "h-56 w-full bg-neutral-50 object-cover lg:absolute lg:inset-y-0 lg:right-0 lg:h-full lg:w-1/2 dark:bg-neutral-800",
        imageDark && "dark:hidden",
      ]}
    />

    {
      imageDark && (
        <img
          src={imageDark}
          alt={imageAlt}
          class="hidden h-56 w-full bg-neutral-800 object-cover lg:absolute lg:inset-y-0 lg:right-0 lg:h-full lg:w-1/2 dark:block"
        />
      )
    }

    <div class="mx-auto grid max-w-7xl lg:grid-cols-2">
      <div
        class="px-6 pt-16 pb-24 sm:pt-20 sm:pb-32 lg:col-start-1 lg:px-8 lg:pt-32"
      >
        <div class="mx-auto max-w-2xl lg:ml-0 lg:max-w-lg">
          <h2
            class="text-base/8 font-semibold text-primary-600 dark:text-primary-400"
          >
            como
          </h2>

          <p
            class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-neutral-900 sm:text-5xl dark:text-white"
          >
            Más que un Pasaporte Digital de Producto
          </p>

          <div
            class="mt-6 space-y-4 text-lg/8 text-neutral-600 dark:text-neutral-300"
          >
            {
              description
                .split("\n\n")
                .map((paragraph) => (
                  <p>
                    Implementar la trazabilidad no consiste únicamente en
                    generar un código QR. Implica organizar información,
                    comprender la cadena de suministro y preparar a tu empresa
                    para responder con confianza a clientes, aliados comerciales
                    y mercados internacionales. En Textile Trace LATAM te
                    acompañamos durante ese proceso para que puedas avanzar paso
                    a paso, según las necesidades de tu negocio.
                  </p>
                ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

<!-- call to action -->


</Layout>
